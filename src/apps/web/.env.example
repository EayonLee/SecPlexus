# Web 独立启动时复制为 .env.local。根启动入口从根 .env 注入同名字段。
# 网络监听
# Web 使用 HTTP，对外 HTTPS 由反向代理终止。
SPX_WEB_PORT=5173
# SPX_WEB_BIND_HOST=0.0.0.0

# 反向代理凭据
# 与 Web 共用的来源校验凭据，使用 32 字节随机量的十六进制编码。
# SPX_WEB_EDGE_TOKEN=

# 服务端连接目标，可用 IP 或内网域名。
SPX_IAM_HOST=127.0.0.1
SPX_IAM_PORT=8081

SPX_CONSOLE_HOST=127.0.0.1
SPX_CONSOLE_PORT=8080

# Ingest 上游。部署未包含 Ingest 时可将这两项同时留空。
SPX_INGEST_HOST=127.0.0.1
SPX_INGEST_PORT=8082
# Ingest 使用原生 TLS 时，设置完整的 HTTPS 上游来源。
# SPX_INGEST_ORIGIN=
