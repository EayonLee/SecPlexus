{
  "openapi": "3.0.3",
  "info": {
    "title": "SecPlexus console schemas",
    "version": "1.0.0"
  },
  "paths": {},
  "components": {
    "schemas": {
      "APIError": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Result"
          },
          {
            "type": "object",
            "properties": {
              "code": {
                "$ref": "#/components/schemas/ErrorCode"
              },
              "data": {
                "nullable": true,
                "enum": [
                  null
                ]
              }
            }
          }
        ]
      },
      "APIConsoleContext": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "org_id": {
            "type": "string",
            "x-go-name": "OrgID"
          },
          "user_id": {
            "type": "string",
            "x-go-name": "UserID"
          },
          "decision_id": {
            "type": "string",
            "x-go-name": "DecisionID"
          }
        },
        "required": [
          "org_id",
          "user_id",
          "decision_id"
        ]
      },
      "APIResult": {
        "$ref": "#/components/schemas/Result"
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "invalid_request",
          "unauthenticated",
          "permission_denied",
          "not_found",
          "conflict",
          "rate_limited",
          "internal_error",
          "service_unavailable",
          "payload_too_large",
          "unsupported_media_type",
          "method_not_allowed",
          "iam.invalid_credentials",
          "iam.invalid_current_password",
          "iam.csrf_invalid",
          "iam.origin_invalid",
          "iam.recent_auth_required"
        ]
      },
      "Result": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "data",
          "request_id"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "nullable": true
          },
          "request_id": {
            "type": "string",
            "minLength": 1,
            "x-go-name": "RequestID"
          }
        }
      }
    }
  }
}