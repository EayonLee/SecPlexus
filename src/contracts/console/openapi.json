{
  "openapi": "3.0.3",
  "info": {
    "title": "SecPlexus Console API",
    "version": "1.0.0",
    "description": "Cookie sessions, organization-scoped RBAC and private service authorization. Versions are decimal strings. No public self-registration."
  },
  "security": [
    {
      "sessionCookie": []
    }
  ],
  "paths": {
    "/api/v1/console/orgs/{org_id}/context": {
      "get": {
        "operationId": "context",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Result"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string",
                          "enum": [
                            "ok"
                          ]
                        },
                        "data": {
                          "$ref": "#/components/schemas/APIConsoleContext"
                        }
                      },
                      "required": [
                        "code",
                        "data"
                      ]
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "parameters": [
          {
            "name": "org_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "x-spx-action": "iam.organizations.read"
      }
    },
    "/api/v1/console/orgs/{org_id}/events": {
      "get": {
        "operationId": "events",
        "responses": {
          "200": {
            "description": "SSE, authorization rechecked every 30 seconds",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "parameters": [
          {
            "name": "org_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "x-spx-action": "iam.organizations.read"
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "spx_session",
        "description": "HTTPS deployments use __Host-spx_session instead."
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid input",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/APIError"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Authentication required",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/APIError"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Permission or CSRF denied",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/APIError"
            }
          }
        }
      },
      "NotFound": {
        "description": "Not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/APIError"
            }
          }
        }
      },
      "Conflict": {
        "description": "Version conflict or protected resource",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/APIError"
            }
          }
        }
      },
      "RateLimited": {
        "description": "Rate limited",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/APIError"
            }
          }
        }
      },
      "Unavailable": {
        "description": "Dependency unavailable",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/APIError"
            }
          }
        }
      },
      "InternalError": {
        "description": "Internal failure",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/APIError"
            }
          }
        }
      }
    },
    "schemas": {
      "Result": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "data",
          "request_id"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "nullable": true
          },
          "request_id": {
            "type": "string",
            "minLength": 1,
            "x-go-name": "RequestID"
          }
        }
      },
      "APIConsoleContext": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "org_id": {
            "type": "string",
            "x-go-name": "OrgID"
          },
          "user_id": {
            "type": "string",
            "x-go-name": "UserID"
          },
          "decision_id": {
            "type": "string",
            "x-go-name": "DecisionID"
          }
        },
        "required": [
          "org_id",
          "user_id",
          "decision_id"
        ]
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "invalid_request",
          "unauthenticated",
          "permission_denied",
          "not_found",
          "conflict",
          "rate_limited",
          "internal_error",
          "service_unavailable",
          "payload_too_large",
          "unsupported_media_type",
          "method_not_allowed",
          "iam.invalid_credentials",
          "iam.invalid_current_password",
          "iam.csrf_invalid",
          "iam.origin_invalid",
          "iam.recent_auth_required"
        ]
      },
      "APIError": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Result"
          },
          {
            "type": "object",
            "properties": {
              "code": {
                "$ref": "#/components/schemas/ErrorCode"
              },
              "data": {
                "nullable": true,
                "enum": [
                  null
                ]
              }
            }
          }
        ]
      }
    }
  }
}