# 环境变量模板：复制为 .env 后填写。进程环境优先；真实的 .env 不提交到仓库。

# ------------------------------------------------------------
# --------------------------- Web ----------------------------
# ------------------------------------------------------------
# 浏览器访问地址，用于 Cookie 与 CSRF 校验；部署时改为实际域名。
SPX_WEB_ORIGIN=http://127.0.0.1:5173
# Web 监听端口。
SPX_WEB_PORT=5173

# ------------------------------------------------------------
# --------------------------- IAM ----------------------------
# ------------------------------------------------------------
# 监听地址与端口。其他服务用同一组 SPX_IAM_HOST/PORT 连接本服务。
SPX_IAM_HOST=127.0.0.1
SPX_IAM_PORT=8081
# 唯一超级管理员：身份与密码仅由此配置管理；修改后重启全部 IAM 副本。
SPX_IAM_BOOTSTRAP_USERNAME=admin
# 必填：至少 12 个字符。值必须加引号，否则 dotenv 会把 # 之后当作注释。
SPX_IAM_BOOTSTRAP_PASSWORD="SecPlexus#2026"
# 必填：CSRF 签名密钥，恰好 32 字节；例如 openssl rand -hex 16
SPX_IAM_CSRF_KEY=
# 登录防护阈值。每个来源地址每分钟、每个账号每 15 分钟允许的认证请求数。
SPX_IAM_LOGIN_IP_RATE=60
SPX_IAM_LOGIN_ACCOUNT_RATE=20
# 会话与撤销：按间隔语义，与时区无关。
SPX_IAM_SESSION_IDLE_TIMEOUT=30m
# 会话最长存活，到期必须重新登录。
SPX_IAM_SESSION_ABSOLUTE_TIMEOUT=8h
# 高风险操作要求多久内重新认证过。
SPX_IAM_REAUTH_WINDOW=30m
# 数据留存：按天计。审计日志合规常按年，别随手改小。
SPX_IAM_AUDIT_RETENTION_DAYS=365
# 已撤销会话记录保留天数。
SPX_IAM_SESSION_RETENTION_DAYS=30
# 反向代理（可选）：只有确实经过可信反代时才填，逗号分隔网段。
# 留空表示不信任任何转发头；填 0.0.0.0/0 等于允许伪造客户端 IP，禁止。
SPX_IAM_TRUSTED_PROXY_CIDRS=
# 日志级别。
SPX_IAM_LOG_LEVEL=info

# ------------------------------------------------------------
# ------------------------- Console --------------------------
# ------------------------------------------------------------
# 监听地址与端口。
SPX_CONSOLE_HOST=127.0.0.1
SPX_CONSOLE_PORT=8080
# 必填：调用 IAM 的凭证，32–512 字节；例如 openssl rand -hex 32
SPX_CONSOLE_IAM_TOKEN=
# 日志级别。
SPX_CONSOLE_LOG_LEVEL=info
# 事件流（SSE）重新鉴权间隔：撤权要在这个时间内生效。
SPX_CONSOLE_STREAM_REAUTH_INTERVAL=30s

# ------------------------------------------------------------
# -------------------------- Ingest --------------------------
# ------------------------------------------------------------
# 监听地址与端口。
SPX_INGEST_HOST=127.0.0.1
SPX_INGEST_PORT=8082
# 必填：调用 IAM 的凭证，32–512 字节，且必须与 IAM 侧 ingest 客户端的 token 不同。
SPX_INGEST_IAM_TOKEN=
# 出站 Kafka：归一化后的事件写到这里，属于 Ingest 自己的输出配置。
SPX_INGEST_KAFKA_BROKERS=127.0.0.1:9092
# 归一化成功事件的 topic。
SPX_INGEST_KAFKA_EVENT_TOPIC=spx.ingest.events
# 解析失败事件的 topic；与事件 topic 分开，坏数据不占正常事件的保留期。
SPX_INGEST_KAFKA_PARSE_FAILURE_TOPIC=spx.ingest.parse-failures
# 传输安全：plaintext / ssl / sasl_plaintext / sasl_ssl。
SPX_INGEST_KAFKA_SECURITY_PROTOCOL=plaintext
# 身份认证：PLAIN / SCRAM-SHA-256 / SCRAM-SHA-512。
SPX_INGEST_KAFKA_SASL_MECHANISM=
SPX_INGEST_KAFKA_SASL_USERNAME=
# 口令只写变量名，值放在部署环境，不落配置文件。
SPX_INGEST_KAFKA_SASL_PASSWORD_ENV=
# 自定义 CA；留空使用系统根证书。
SPX_INGEST_KAFKA_TLS_CA_FILE=
# 入站 Kafka 的接入点集合刷新间隔（broker/topic 属于每个接入点）。
SPX_INGEST_INPUT_KAFKA_RELOAD_INTERVAL=30s

# ------------------------------------------------------------
# ------------------------ PostgreSQL ------------------------
# ------------------------------------------------------------
# 默认共用同一实例、同一数据库、同一账号；运行、迁移、维护均使用此连接。
SPX_POSTGRES_HOST=127.0.0.1
SPX_POSTGRES_PORT=5432
SPX_POSTGRES_DATABASE=secplexus
SPX_POSTGRES_USER=secplexus
SPX_POSTGRES_PASSWORD=secplexus
# 本机通常为 disable；远程连接按数据库要求设置。
SPX_POSTGRES_SSLMODE=disable

# ------------------------------------------------------------
# -------------------------- Redis ---------------------------
# ------------------------------------------------------------
# 默认共用同一实例、同一数据库、同一账号；运行、迁移、维护均使用此连接。
SPX_REDIS_HOST=127.0.0.1
SPX_REDIS_PORT=6379
# Redis ACL 用户名，默认 default；无密码服务可将 password 留空。
SPX_REDIS_USER=default
SPX_REDIS_PASSWORD=secplexus
# key 固定为 spx:模块:业务:标识，由代码模板生成，不提供前缀配置。
SPX_REDIS_DB=0
