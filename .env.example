# ------------------------------------------------------------
# ---------------------------- Web ----------------------------
# ------------------------------------------------------------
SPX_WEB_HOST=127.0.0.1
SPX_WEB_PORT=5173
# 浏览器访问地址，用于Cookie与CSRF校验，也是Web公开元信息地址的默认值。
SPX_PUBLIC_URL=http://127.0.0.1:5173

# ------------------------------------------------------------
# ---------------------------- IAM ----------------------------
# ------------------------------------------------------------
SPX_IAM_HOST=0.0.0.0
SPX_IAM_PORT=8081
# 内部鉴权接口，不经公开Web入口代理。
SPX_IAM_INTERNAL_HOST=0.0.0.0
SPX_IAM_INTERNAL_PORT=9081
# 仅空账号库使用，默认 admin/secplexus；已有账号不会被覆盖。
SPX_IAM_BOOTSTRAP_USERNAME=admin
SPX_IAM_BOOTSTRAP_PASSWORD=secplexus
# CSRF签名密钥，恰好32字节，可用openssl rand -hex 16生成。
SPX_IAM_CSRF_KEY=
# 相对路径以仓库根目录为准；pnpm certs:generate可生成本机证书。
SPX_IAM_TLS_CERT_FILE=certs/iam.crt
SPX_IAM_TLS_KEY_FILE=certs/iam.key

# ------------------------------------------------------------
# -------------------------- Console --------------------------
# ------------------------------------------------------------
SPX_CONSOLE_HOST=0.0.0.0
SPX_CONSOLE_PORT=8080
# 调用IAM的凭证，至少32字节，可用openssl rand -hex 32生成。
SPX_CONSOLE_IAM_TOKEN=

# ------------------------------------------------------------
# ------------------------- PostgresSQL ------------------------
# ------------------------------------------------------------
# 默认共用同一实例、同一数据库、同一账号；运行、迁移、维护均使用此连接。
# 账号需有本项目的建表和迁移权限。模块独立连接可修改其config.yaml。
SPX_POSTGRES_HOST=127.0.0.1
SPX_POSTGRES_PORT=5432
SPX_POSTGRES_DATABASE=secplexus
SPX_POSTGRES_USER=secplexus
SPX_POSTGRES_PASSWORD=secplexus
# 本机通常为disable；远程连接按数据库要求设置。
SPX_POSTGRES_MODELESS=disable

# ------------------------------------------------------------
# --------------------------- Redis ---------------------------
# ------------------------------------------------------------
SPX_REDIS_HOST=127.0.0.1
SPX_REDIS_PORT=6379
# Redis ACL 用户名，默认 default；无密码服务可将 password 留空。
SPX_REDIS_USER=default
SPX_REDIS_PASSWORD=secplexus
SPX_REDIS_DB=0
