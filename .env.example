# ------------------------------------------------------------
# ---------------------------- Web ---------------------------
# ------------------------------------------------------------
SPX_WEB_PORT=5173
# IAM 信任的浏览器来源；本机按 Web 端口自动生成。
# 使用服务器 IP 或 Nginx 域名/HTTPS 入口时填写实际来源，如 https://sec.example.com。
SPX_WEB_ORIGIN=

# ------------------------------------------------------------
# ---------------------------- IAM ---------------------------
# ------------------------------------------------------------
SPX_IAM_HOST=127.0.0.1
SPX_IAM_PORT=8081
# 唯一超级管理员：身份与密码仅由此配置管理；修改后重启全部 IAM 副本。
SPX_IAM_BOOTSTRAP_USERNAME=admin
# 必须修改：至少 12 个字符；缺失或过短时 IAM 拒绝启动。
# 值必须加引号：.env 遵循 dotenv 语义，未加引号时 "#" 之后会被当作注释丢弃。
SPX_IAM_BOOTSTRAP_PASSWORD="SecPlexus#2026"
# 必填：CSRF 签名密钥，恰好 32 字节；例如 openssl rand -hex 16
SPX_IAM_CSRF_KEY=
# 登录防护阈值的默认值；不设置时使用 config.yaml 的默认值。
# 每个来源地址每分钟允许的认证请求数。
SPX_IAM_LOGIN_IP_RATE=60
# 每个账号每 15 分钟允许的认证请求数。
SPX_IAM_LOGIN_ACCOUNT_RATE=20

# ------------------------------------------------------------
# -------------------------- Console -------------------------
# ------------------------------------------------------------
SPX_CONSOLE_HOST=127.0.0.1
SPX_CONSOLE_PORT=8080
# 必填：调用 IAM 的凭证，32–512 字节；例如 openssl rand -hex 32
SPX_CONSOLE_IAM_TOKEN=


# ---- Ingest 数据接入（SPX_INGEST_*） ----
# 数据接入服务监听端口。
SPX_INGEST_HOST=127.0.0.1
SPX_INGEST_PORT=8082
# 调用 IAM 的服务凭证（32-512 字节），必须与 IAM config.yaml 的 service_clients.ingest.token 一致。
SPX_INGEST_IAM_TOKEN=
# Kafka broker 地址（逗号分隔）。必填：Ingest 的唯一缓冲层。
SPX_KAFKA_BROKERS=
# ------------------------------------------------------------
# ------------------------- PostgreSQL ----------------------
# ------------------------------------------------------------
# 默认共用同一实例、同一数据库、同一账号；运行、迁移、维护均使用此连接。
SPX_POSTGRES_HOST=127.0.0.1
SPX_POSTGRES_PORT=5432
SPX_POSTGRES_DATABASE=secplexus
SPX_POSTGRES_USER=secplexus
SPX_POSTGRES_PASSWORD=secplexus
# 本机通常为disable；远程连接按数据库要求设置。
SPX_POSTGRES_SSLMODE=disable

# ------------------------------------------------------------
# --------------------------- Redis --------------------------
# ------------------------------------------------------------
# 默认共用同一实例、同一数据库、同一账号；运行、迁移、维护均使用此连接。
SPX_REDIS_HOST=127.0.0.1
SPX_REDIS_PORT=6379
# Redis ACL 用户名，默认 default；无密码服务可将 password 留空。
SPX_REDIS_USER=default
SPX_REDIS_PASSWORD=secplexus
SPX_REDIS_DB=0
