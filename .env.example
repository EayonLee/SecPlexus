# 复制为 .env 后填写。进程环境优先，私有 .env 不提交。
# 取消可选项所在行的注释即可覆盖默认值。值含空格、# 或 $ 时用单引号包裹。
# 开发与部署入口见 docs/development/configuration.md。

# ------------------------------------------------------------
# --------------------------- Web ----------------------------
# ------------------------------------------------------------
# 网络监听与连接
# 源码启动的监听端口，也是整栈 Compose 发布到宿主机的端口。
SPX_WEB_PORT=5173
# 独立运行时可覆盖监听地址。Compose 在容器内监听 0.0.0.0。
# SPX_WEB_BIND_HOST=0.0.0.0
# 留空时使用 http://127.0.0.1:<Web 端口>。经反向代理或域名访问时填写实际来源。
SPX_WEB_ORIGIN=

# 反向代理凭据
# 与 Web 共用的来源校验凭据，使用 32 字节随机量的十六进制编码。
SPX_WEB_EDGE_TOKEN=

# ------------------------------------------------------------
# --------------------------- IAM ----------------------------
# ------------------------------------------------------------
# 网络监听与连接
SPX_IAM_PORT=8081
# 独立运行时，HOST 是连接目标，BIND_HOST 是本机监听地址。
# 同机启动自动推导连接目标，Compose 使用容器服务名。
# SPX_IAM_HOST=127.0.0.1
# SPX_IAM_BIND_HOST=127.0.0.1
# 可信反向代理网段，逗号分隔。留空时按直连地址识别请求来源。
SPX_IAM_TRUSTED_PROXY_CIDRS=

# 托管管理员
# 首次部署须填写密码，长度 12–128 个字符。
# 已部署实例改名或改密时执行 sync-administrator。
SPX_IAM_BOOTSTRAP_USERNAME=admin
SPX_IAM_BOOTSTRAP_PASSWORD=

# 会话保护。CSRF 签名密钥必填，恰好 32 字节，可用 openssl rand -hex 16 生成。
SPX_IAM_CSRF_KEY=

# 登录保护
# 登录限流分别按来源 IP（每分钟）和账号（每 15 分钟）计数。
SPX_IAM_LOGIN_IP_RATE=60
SPX_IAM_LOGIN_ACCOUNT_RATE=20
# 账号连续登录失败达到阈值后的锁定时长。
SPX_IAM_LOGIN_MAX_FAILURES=5
SPX_IAM_LOGIN_LOCK_DURATION=15m

# 会话时限
# 会话空闲时限、最长时限以及高风险操作的二次认证窗口。
SPX_IAM_SESSION_IDLE_TIMEOUT=30m
SPX_IAM_SESSION_ABSOLUTE_TIMEOUT=8h
SPX_IAM_REAUTH_WINDOW=30m

# 数据保留
# 单位为天。由 IAM maintain 清理审计记录和已结束会话。
SPX_IAM_AUDIT_RETENTION_DAYS=365
SPX_IAM_SESSION_RETENTION_DAYS=30

# 日志
# 日志级别，支持 debug、info、warn、error。
SPX_IAM_LOG_LEVEL=info
# 以下选项用于独立运行。FILE 留空时关闭文件日志，Compose 使用容器日志。
# MAX_SIZE_MB 按 MiB 计，MAX_AGE_DAYS 按天计。
# SPX_IAM_LOG_STDOUT=true
# SPX_IAM_LOG_FILE=logs/iam.log
# SPX_IAM_LOG_MAX_SIZE_MB=50
# SPX_IAM_LOG_MAX_BACKUPS=5
# SPX_IAM_LOG_MAX_AGE_DAYS=14
# SPX_IAM_LOG_COMPRESS=true

# ------------------------------------------------------------
# ------------------------- Console --------------------------
# ------------------------------------------------------------
# 网络监听与连接
SPX_CONSOLE_PORT=8080
# 独立运行时，HOST 是连接目标，BIND_HOST 是本机监听地址。
# 同机启动自动推导连接目标，Compose 使用容器服务名。
# SPX_CONSOLE_HOST=127.0.0.1
# SPX_CONSOLE_BIND_HOST=127.0.0.1

# 服务凭据
# 调用 IAM 的独立服务凭据，必填，长度 32–512 字节。
SPX_CONSOLE_IAM_TOKEN=

# 日志
# 日志级别，支持 debug、info、warn、error。
SPX_CONSOLE_LOG_LEVEL=info
# 以下选项用于独立运行。FILE 留空时关闭文件日志，Compose 使用容器日志。
# MAX_SIZE_MB 按 MiB 计，MAX_AGE_DAYS 按天计。
# SPX_CONSOLE_LOG_STDOUT=true
# SPX_CONSOLE_LOG_FILE=logs/console.log
# SPX_CONSOLE_LOG_MAX_SIZE_MB=50
# SPX_CONSOLE_LOG_MAX_BACKUPS=5
# SPX_CONSOLE_LOG_MAX_AGE_DAYS=14
# SPX_CONSOLE_LOG_COMPRESS=true

# ------------------------------------------------------------
# -------------------------- Ingest --------------------------
# ------------------------------------------------------------
# 网络监听与连接
SPX_INGEST_PORT=8082
# 独立运行时，HOST 是连接目标，BIND_HOST 是本机监听地址。
# 同机启动自动推导连接目标，Compose 使用容器服务名。
# SPX_INGEST_HOST=127.0.0.1
# SPX_INGEST_BIND_HOST=127.0.0.1
# 指定 Web 连接 Ingest 的完整上游来源。留空时由连接目标和协议推导。
# SPX_INGEST_ORIGIN=

# 服务凭据
# 调用 IAM 的独立服务凭据，必填，长度 32–512 字节。
SPX_INGEST_IAM_TOKEN=

# HTTP 接入
# 请求体上限按字节计，并发上限为同一实例同时处理的请求数。
SPX_INGEST_HTTP_MAX_BODY_BYTES=10485760
SPX_INGEST_HTTP_MAX_CONCURRENT_REQUESTS=16
# 每个数据接入的每秒请求配额与突发额度。源码启动和 Compose 均支持。
# SPX_INGEST_HTTP_RATE_PER_SEC=50
# SPX_INGEST_HTTP_RATE_BURST=200
# 独立运行的原生 TLS。证书和私钥须同时填写。
# SPX_INGEST_TLS_CERT_FILE=
# SPX_INGEST_TLS_KEY_FILE=

# Kafka 接入
# 刷新已启用的 Kafka 接入配置。外部凭据在 Ingest config.yaml 的 input.kafka.credentials 声明。
# SPX_INGEST_INPUT_KAFKA_RELOAD_INTERVAL=30s

# Syslog 接入
# 刷新已启用的 Syslog 接入配置。独立运行可覆盖监听地址，留空时跟随 Ingest 的监听地址。
# SPX_INGEST_SYSLOG_RELOAD_INTERVAL=10s
# SPX_INGEST_SYSLOG_HOST=

# 解析与批量发布
# Worker 数为 0 时按可用 CPU 自动选择。待解析队列按条数计。
# SPX_INGEST_WORKERS=0
# SPX_INGEST_QUEUE_DEPTH=10000
# 待解析及正在解析的输入共用字节预算。
SPX_INGEST_MAX_IN_FLIGHT_BYTES=67108864
# 发布批量按条数计，未满批时按最长等待时间发布。
# SPX_INGEST_BATCH_SIZE=500
# SPX_INGEST_FLUSH_INTERVAL=2s

# 日志
# 日志级别，支持 debug、info、warn、error。
SPX_INGEST_LOG_LEVEL=info
# 以下选项用于独立运行。FILE 留空时关闭文件日志，Compose 使用容器日志。
# MAX_SIZE_MB 按 MiB 计，MAX_AGE_DAYS 按天计。
# SPX_INGEST_LOG_STDOUT=true
# SPX_INGEST_LOG_FILE=logs/ingest.log
# SPX_INGEST_LOG_MAX_SIZE_MB=50
# SPX_INGEST_LOG_MAX_BACKUPS=5
# SPX_INGEST_LOG_MAX_AGE_DAYS=14
# SPX_INGEST_LOG_COMPRESS=true

# ------------------------------------------------------------
# ------------------------ PostgreSQL ------------------------
# ------------------------------------------------------------
# 自带实例或源码运行连接本机实例时，使用以下端口、库名与账号。
# 下面的密码用于开发，部署时填写实际密码。
SPX_POSTGRESQL_PORT=5432
SPX_POSTGRESQL_DATABASE=secplexus
SPX_POSTGRESQL_USER=secplexus
SPX_POSTGRESQL_PASSWORD=secplexus

# 独立运行接外部实例时填写完整 URL，Compose 自带实例使用服务名。
# 例如 postgresql://user:password@host:5432/secplexus?sslmode=require
SPX_POSTGRESQL_URL=

# ------------------------------------------------------------
# -------------------------- Redis ---------------------------
# ------------------------------------------------------------
# 自带实例或源码运行连接本机实例时，使用以下端口和账号。
# 下面的密码用于开发，部署时填写实际密码。
SPX_REDIS_PORT=6379
SPX_REDIS_USER=default
SPX_REDIS_PASSWORD=secplexus
# 逻辑库编号。IAM 和 Ingest 使用同一个库。
# SPX_REDIS_DB=0

# 独立运行接外部实例时填写完整 URL，库号写在 URL 中。
# 例如 rediss://user:password@host:6379/0
SPX_REDIS_URL=

# ------------------------------------------------------------
# -------------------------- Kafka ---------------------------
# ------------------------------------------------------------
# 平台业务主题保留天数。已有主题需先修改 broker 的主题配置，再重建应用容器。
SPX_KAFKA_RETENTION_DAYS=7
# 共享集群中每套部署使用稳定且唯一的命名空间。
SPX_KAFKA_NAMESPACE=spx

# 独立运行的集群地址与传输选项。整栈 Compose 使用自带 Kafka。
# 独立运行 Ingest 须填写实际地址。多个 broker 用逗号分隔。
SPX_KAFKA_BROKERS=
SPX_KAFKA_SECURITY_PROTOCOL=plaintext
SPX_KAFKA_TLS_CA_FILE=

# 独立运行连接启用 SASL 的平台集群时，配置 Ingest 发布者身份。
SPX_INGEST_KAFKA_PUBLISH_SASL_MECHANISM=
SPX_INGEST_KAFKA_PUBLISH_SASL_USERNAME=
SPX_INGEST_KAFKA_PUBLISH_SASL_PASSWORD=

# 独立运行连接启用 SASL 的平台集群时，配置 Ingest 事件写入器身份。
SPX_INGEST_KAFKA_STORE_SASL_MECHANISM=
SPX_INGEST_KAFKA_STORE_SASL_USERNAME=
SPX_INGEST_KAFKA_STORE_SASL_PASSWORD=

# ------------------------------------------------------------
# ------------------------ ClickHouse ------------------------
# ------------------------------------------------------------
# ClickHouse 永久保存已写入的事件。两种运行方式使用同一个库名配置。
SPX_INGEST_CLICKHOUSE_DATABASE=spx

# 独立运行接外部实例时填写 URL。整栈 Compose 使用自带 ClickHouse。
SPX_CLICKHOUSE_URL=

# 写入、回查和迁移使用独立账号。留空时，自带实例使用 Compose 开发账号。
SPX_INGEST_CLICKHOUSE_USERNAME=
SPX_INGEST_CLICKHOUSE_PASSWORD=
# 回查账号。
SPX_INGEST_CLICKHOUSE_READER_USERNAME=
SPX_INGEST_CLICKHOUSE_READER_PASSWORD=
# 迁移账号。
SPX_INGEST_CLICKHOUSE_MIGRATION_USERNAME=
SPX_INGEST_CLICKHOUSE_MIGRATION_PASSWORD=
