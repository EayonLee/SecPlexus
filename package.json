{
  "name": "secplexus",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "node scripts/start.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "pnpm --dir src/apps/web typecheck",
    "lint": "pnpm --dir src/apps/web lint",
    "preview": "node scripts/start.mjs preview",
    "compose:up": "node scripts/compose.mjs",
    "test:unit": "node --test scripts/*.test.mjs && go test ./src/... && pnpm --dir src/apps/web test:unit",
    "test:integration": "node tests/integration/run.mjs",
    "test:e2e": "pnpm --dir src/apps/web test:e2e",
    "certs:generate": "node scripts/generate-certs.mjs",
    "catalogs:generate": "node scripts/generate-catalogs.mjs",
    "catalogs:check": "node scripts/generate-catalogs.mjs --check"
  }
}
