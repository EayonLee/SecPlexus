{
  "name": "secplexus",
  "description": "An AI-native security operations platform built around identity.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EayonLee/SecPlexus.git"
  },
  "homepage": "https://github.com/EayonLee/SecPlexus#readme",
  "bugs": {
    "url": "https://github.com/EayonLee/SecPlexus/issues"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "config:check": "node scripts/start.mjs check-config",
    "dev": "node scripts/start.mjs dev",
    "build": "node scripts/build.mjs",
    "typecheck": "pnpm --dir src/apps/web typecheck",
    "lint": "pnpm --dir src/apps/web lint",
    "preview": "node scripts/start.mjs preview",
    "stop": "node scripts/stop.mjs",
    "compose:up": "node scripts/compose.mjs",
    "test:unit": "node scripts/test-scripts.mjs && go test ./src/... && pnpm --dir src/apps/web test:unit",
    "test:integration": "node tests/integration/run.mjs",
    "test:e2e": "pnpm --dir src/apps/web test:e2e",
    "catalogs:generate": "node scripts/generate-catalogs.mjs",
    "catalogs:check": "node scripts/generate-catalogs.mjs --check && node scripts/migrations-check.mjs"
  }
}
